<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TabletTracker.Controls"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="TabletTracker.Pages.ScanQrPage"
             Title="Skanuj kod QR"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid ColumnDefinitions="224,*">

        <controls:SidebarView Grid.Column="0" ActiveRoute="Scan" />

        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <Label Grid.Row="0" Text="Zeskanuj kod QR na tablecie"
                   FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center" Margin="0,40,0,0" />

            <!-- Obszar skanowania -->
            <Grid Grid.Row="1" Padding="34,30,34,20">

                <!-- Podgląd kamery z ramką skanera -->
                <Grid x:Name="ScannerArea"
                      VerticalOptions="Center" HorizontalOptions="Center"
                      WidthRequest="430" HeightRequest="430">

                    <zxing:CameraBarcodeReaderView
                        x:Name="CameraBarcodeReader"
                        BarcodesDetected="OnBarcodesDetected"
                        IsDetecting="True"
                        IsTorchOn="True" />

                    <!-- Ramka i podpisy (nakładka, ignoruje dotyk) -->
                    <Grid InputTransparent="True">
                        <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="1" Opacity="0.45"
                                 WidthRequest="132" HeightRequest="132"
                                 HorizontalOptions="Center" VerticalOptions="Center" />

                        <BoxView Color="{StaticResource Accent}" WidthRequest="40" HeightRequest="2"
                                 HorizontalOptions="Start" VerticalOptions="Start" Margin="16" />
                        <BoxView Color="{StaticResource Accent}" WidthRequest="2" HeightRequest="40"
                                 HorizontalOptions="Start" VerticalOptions="Start" Margin="16" />

                        <BoxView Color="{StaticResource Accent}" WidthRequest="40" HeightRequest="2"
                                 HorizontalOptions="End" VerticalOptions="Start" Margin="16" />
                        <BoxView Color="{StaticResource Accent}" WidthRequest="2" HeightRequest="40"
                                 HorizontalOptions="End" VerticalOptions="Start" Margin="16" />

                        <BoxView Color="{StaticResource Accent}" WidthRequest="40" HeightRequest="2"
                                 HorizontalOptions="Start" VerticalOptions="End" Margin="16" />
                        <BoxView Color="{StaticResource Accent}" WidthRequest="2" HeightRequest="40"
                                 HorizontalOptions="Start" VerticalOptions="End" Margin="16" />

                        <BoxView Color="{StaticResource Accent}" WidthRequest="40" HeightRequest="2"
                                 HorizontalOptions="End" VerticalOptions="End" Margin="16" />
                        <BoxView Color="{StaticResource Accent}" WidthRequest="2" HeightRequest="40"
                                 HorizontalOptions="End" VerticalOptions="End" Margin="16" />

                        <VerticalStackLayout VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,24" Spacing="4">
                            <Label Text="Urządzenie zostanie rozpoznane automatycznie na"
                                   FontSize="12.5" TextColor="#8CF3F4EF" HorizontalTextAlignment="Center" />
                            <Label Text="podstawie kodu przypisanego do tabletu"
                                   FontSize="12.5" TextColor="#8CF3F4EF" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Fallback: brak kamery / brak uprawnień -->
                    <VerticalStackLayout x:Name="UnsupportedPanel" IsVisible="False"
                                         BackgroundColor="#10161F" Padding="24" Spacing="8"
                                         VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="Skanowanie niedostępne"
                               FontSize="15" FontAttributes="Bold" TextColor="#F3F4EF"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="UnsupportedMessageLabel"
                               FontSize="12.5" TextColor="#8CF3F4EF"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>