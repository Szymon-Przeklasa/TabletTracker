<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="#99727F8C" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="#8C1B2430" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="MutedLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="#99727F8C" />
    </Style>

    <!-- Duży pomarańczowy przycisk akcji (np. "Dodaj ucznia") -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="HeightRequest" Value="46" />
    </Style>

    <!-- Przycisk obramowany (np. filtry "Wszystkie / Przypisane / Wolne") -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BorderColor" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HeightRequest" Value="37" />
    </Style>

    <Style x:Key="OutlineButtonActive" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource SidebarBackground}" />
        <Setter Property="TextColor" Value="{StaticResource TextOnDark}" />
        <Setter Property="BorderColor" Value="{StaticResource SidebarBackground}" />
    </Style>

    <Style x:Key="FieldFrame" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource BorderSoft}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <Style x:Key="FieldEntry" TargetType="Entry">
        <Setter Property="PlaceholderColor" Value="#99727F8C" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- Ramka klikalnego elementu menu w sidebarze -->
    <Style x:Key="SidebarItemFrame" TargetType="Border">
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="SidebarItemFrameActive" TargetType="Border" BasedOn="{StaticResource SidebarItemFrame}">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
    </Style>

    <!-- Element menu w sidebarze -->
    <Style x:Key="SidebarItemLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="#CCF3F4EF" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SidebarItemLabelActive" TargetType="Label" BasedOn="{StaticResource SidebarItemLabel}">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

</ResourceDictionary>
