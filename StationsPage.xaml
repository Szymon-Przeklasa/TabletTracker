<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TabletTracker.Controls"
             x:Class="TabletTracker.Pages.StationsPage"
             Title="Stanowiska"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid ColumnDefinitions="224,*">

        <controls:SidebarView Grid.Column="0" ActiveRoute="Stations" />

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,*"
              Padding="34,30,34,20" RowSpacing="16">

            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label Text="Stanowiska" Style="{StaticResource PageTitle}" />
                <Label x:Name="SubtitleLabel" Text="Sala P1" Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>

            <!-- Pasek statystyk -->
            <Border Grid.Row="1" BackgroundColor="{StaticResource CardMuted}"
                    Stroke="{StaticResource BorderHairline}" StrokeThickness="1"
                    Padding="19,15">
                <Grid ColumnDefinitions="Auto,16,Auto,16,Auto,16,Auto,*,Auto" ColumnSpacing="0" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="Przypisane:" FontSize="13" TextColor="#99727F8C" />
                    <Label Grid.Column="1" x:Name="AssignedCountLabel" Text="0"
                           FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Label Grid.Column="2" Text="Wolne:" FontSize="13" TextColor="#99727F8C" />
                    <Label Grid.Column="3" x:Name="FreeCountLabel" Text="0"
                           FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Label Grid.Column="4" Text="Razem:" FontSize="13" TextColor="#99727F8C" />
                    <Label Grid.Column="5" x:Name="TotalCountLabel" Text="0"
                           FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Button Grid.Column="7" Text="Zdejmij przypisanie ze wszystkich"
                            Style="{StaticResource OutlineButton}" FontSize="12"
                            Padding="20,0" HeightRequest="34" HorizontalOptions="End"
                            Clicked="OnUnassignAllClicked" />
                </Grid>
            </Border>

            <!-- Dodawanie / usuwanie stanowisk -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16">
                <Border Grid.Column="0" Style="{StaticResource FieldFrame}">
                    <Entry x:Name="StationCodeEntry"
                           Placeholder="Kod stanowiska, np. 18"
                           Style="{StaticResource FieldEntry}" Margin="17,0" />
                </Border>
                <Button Grid.Column="1" Text="Dodaj stanowisko"
                        Style="{StaticResource PrimaryButton}" Clicked="OnAddStationClicked" />
                <Button Grid.Column="2" x:Name="UnassignStationButton"
                        Text="Zdejmij przypisanie"
                        Style="{StaticResource PrimaryButton}" IsVisible="False"
                        Clicked="OnUnassignStationClicked" />
                <Button Grid.Column="3" x:Name="RemoveStationButton"
                        Text="Usuń stanowisko"
                        Style="{StaticResource PrimaryButton}" IsVisible="False"
                        Clicked="OnRemoveStationClicked" />
            </Grid>

            <!-- Filtry -->
            <HorizontalStackLayout Grid.Row="3" Spacing="10">
                <Button x:Name="FilterAllButton" Text="Wszystkie"
                        Style="{StaticResource OutlineButtonActive}" WidthRequest="94"
                        Padding="17,0" Clicked="OnFilterAllClicked" />
                <Button x:Name="FilterAssignedButton" Text="Przypisane"
                        Style="{StaticResource OutlineButton}" WidthRequest="99"
                        Padding="17,0" Clicked="OnFilterAssignedClicked" />
                <Button x:Name="FilterFreeButton" Text="Wolne"
                        Style="{StaticResource OutlineButton}" WidthRequest="72"
                        Padding="17,0" Clicked="OnFilterFreeClicked" />
            </HorizontalStackLayout>

            <!-- Siatka stanowisk -->
            <Grid Grid.Row="4" x:Name="GridArea">
                <CollectionView x:Name="StationsGrid"
                                ItemsSource="{Binding Stations}"
                                SelectionMode="Single"
                                SizeChanged="OnStationsGridSizeChanged"
                                SelectionChanged="OnStationSelectionChanged">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="5"
                                         HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="1" Padding="12" HeightRequest="142"
                                    BackgroundColor="{Binding IsAssigned, Converter={StaticResource StationBgConverter}}"
                                    Stroke="{Binding IsAssigned, Converter={StaticResource StationBorderConverter}}">
                                <Grid RowDefinitions="Auto,Auto,*">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding DisplayCode}"
                                               FontSize="15" FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}" />
                                        <Ellipse Grid.Column="1" WidthRequest="8" HeightRequest="8"
                                                 VerticalOptions="Center"
                                                 Fill="{Binding IsAssigned, Converter={StaticResource StationDotConverter}}" />
                                    </Grid>
                                    <Label Grid.Row="1" Text="{Binding TabletInfo}"
                                           FontSize="10.5" TextColor="#727F8C" Margin="0,4,0,0" />
                                    <Label Grid.Row="2" Text="{Binding StudentInfo}" FontSize="12"
                                           VerticalOptions="End" TextColor="{StaticResource TextPrimary}"
                                           FontAttributes="{Binding IsAssigned, Converter={StaticResource StationFontConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>