<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TabletTracker.Controls"
             x:Class="TabletTracker.Pages.SettingsPage"
             Title="Ustawienia"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid ColumnDefinitions="224,*">

        <controls:SidebarView Grid.Column="0" ActiveRoute="Settings" />

        <Grid Grid.Column="1" RowDefinitions="Auto,*" Padding="34,30,34,20" RowSpacing="16">

            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label Text="Ustawienia" Style="{StaticResource PageTitle}" />
                <Label Text="Konfiguracja aplikacji" Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>

            <Label Grid.Row="1" Text="Ekran ustawień — w przygotowaniu." Style="{StaticResource MutedLabel}" />

        </Grid>
    </Grid>
</ContentPage>