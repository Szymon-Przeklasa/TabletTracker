<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TabletTracker.Controls"
             x:Class="TabletTracker.Pages.ManageClassesPage"
             Title="Zarządzaj klasami"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid ColumnDefinitions="224,*">

        <controls:SidebarView Grid.Column="0" ActiveRoute="Classes" />

        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Padding="34,30,34,20" RowSpacing="16">

            <!-- Pasek: aktualna klasa -->
            <Border Grid.Row="0" BackgroundColor="{StaticResource CardMuted}" Stroke="{StaticResource BorderHairline}" StrokeThickness="1" Padding="19,15">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                    <Border Grid.Column="0" BackgroundColor="{StaticResource SidebarBackground}" Padding="10,5" StrokeThickness="0">
                        <Label Text="ZARZĄDZANIE" FontSize="13.5" FontAttributes="Bold" TextColor="{StaticResource TextOnDark}" />
                    </Border>
                    <BoxView Grid.Column="1" WidthRequest="1" HeightRequest="18" Color="{StaticResource BorderSoft}" />
                    <Label Grid.Column="2" Text="Klasa 2TI 2" FontSize="13.5" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="Zmień klasę" FontSize="13.5" TextColor="#99727F8C" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Lista uczniów -->
            <CollectionView Grid.Row="1" ItemsSource="{Binding Students}"
                             SelectionMode="Single" SelectedItem="{Binding SelectedStudent}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,12" ColumnDefinitions="34,12,*,Auto" ColumnSpacing="0">
                            <Grid.GestureRecognizers/>
                            <BoxView Grid.ColumnSpan="4" HeightRequest="1" Color="{StaticResource BorderHairline}" VerticalOptions="Start" />

                            <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                                    BackgroundColor="{Binding IsSelected, Converter={StaticResource AvatarBgConverter}}"
                                    StrokeShape="RoundRectangle 17">
                                <Label Text="{Binding Initials}" FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <Label Grid.Column="2" Text="{Binding FullName}" FontSize="14.5"
                                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />

                            <Label Grid.Column="3" Text="✓" IsVisible="{Binding IsSelected}"
                                   FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Dolny pasek: pole + akcje -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                <Border Grid.Column="0" Style="{StaticResource FieldFrame}">
                    <Entry Placeholder="Wpisz ucznia do dodania" Style="{StaticResource FieldEntry}" Margin="17,0" />
                </Border>
                <Button Grid.Column="1" Text="Dodaj ucznia" Style="{StaticResource PrimaryButton}" />
                <Button Grid.Column="2" Text="Usuń ucznia" Style="{StaticResource PrimaryButton}" />
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
