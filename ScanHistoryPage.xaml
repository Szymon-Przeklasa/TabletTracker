<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TabletTracker.Controls"
             x:Class="TabletTracker.Pages.ScanHistoryPage"
             Title="Historia skanów"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid ColumnDefinitions="224,*">

        <controls:SidebarView Grid.Column="0" ActiveRoute="History" />

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Padding="34,30,34,20" RowSpacing="16">

            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label Text="Historia skanów" Style="{StaticResource PageTitle}" />
                <Label x:Name="SubtitleLabel" Text="Wszystkie zapisy" Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>

            <!-- Pasek filtrów -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource FieldFrame}" WidthRequest="180">
                    <Picker x:Name="DateFilterPicker" Title="Data: wszystkie"
                            FontSize="12.5" TextColor="#727F8C" Margin="15,0"
                            VerticalOptions="Center"
                            SelectedIndexChanged="OnDateFilterChanged" />
                </Border>
                <Border Grid.Column="1" Style="{StaticResource FieldFrame}" WidthRequest="190">
                    <Picker x:Name="ClassFilterPicker" Title="Klasa: wszystkie"
                            FontSize="12.5" TextColor="#727F8C" Margin="15,0"
                            VerticalOptions="Center"
                            SelectedIndexChanged="OnClassFilterChanged" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource FieldFrame}">
                    <Entry x:Name="SearchEntry" Placeholder="Szukaj (uczeń, tablet, stanowisko)"
                           Style="{StaticResource FieldEntry}" Margin="15,0"
                           TextChanged="OnSearchChanged" />
                </Border>
            </Grid>

            <!-- Tabela -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*">

                <!-- Nagłówek tabeli -->
                <Grid Grid.Row="0" ColumnDefinitions="72,72,70,110,*,105,130" Padding="10,8">
                    <BoxView Grid.ColumnSpan="7" HeightRequest="1" Color="{StaticResource BorderStrong}" VerticalOptions="End" />
                    <Label Grid.Column="0" Text="DATA" Style="{StaticResource SectionLabel}" />
                    <Label Grid.Column="1" Text="GODZINA" Style="{StaticResource SectionLabel}" />
                    <Label Grid.Column="2" Text="STAN." Style="{StaticResource SectionLabel}" />
                    <Label Grid.Column="3" Text="TABLET" Style="{StaticResource SectionLabel}" />
                    <Label Grid.Column="4" Text="UCZEŃ" Style="{StaticResource SectionLabel}" />
                    <Label Grid.Column="5" Text="KLASA" Style="{StaticResource SectionLabel}" />
                    <Label Grid.Column="6" Text="NAUCZYCIEL" Style="{StaticResource SectionLabel}" />
                </Grid>

                <!-- Wiersze -->
                <CollectionView Grid.Row="1" ItemsSource="{Binding Entries}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="72,72,70,110,*,105,130" Padding="10,12">
                                <BoxView Grid.ColumnSpan="7" HeightRequest="1" Color="{StaticResource BorderHairline}" VerticalOptions="End" />
                                <Label Grid.Column="0" Text="{Binding Date}" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="1" Text="{Binding Time}" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="2" Text="{Binding Station}" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="3" Text="{Binding Tablet}" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="4" Text="{Binding Student}" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="5" Text="{Binding Class}" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="6" Text="{Binding Teacher}" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>