<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Tła -->
    <Color x:Key="AppBackground">#F3F4EF</Color>
    <Color x:Key="SidebarBackground">#1B2430</Color>
    <Color x:Key="CardMuted">#E4E6E0</Color>
    <Color x:Key="RowSelected">#FFE3D2</Color>
    <Color x:Key="AvatarNeutral">#C9CDC3</Color>

    <!-- Akcent -->
    <Color x:Key="Accent">#FF6A2B</Color>
    <Color x:Key="AccentSoft">#FFE3D2</Color>

    <!-- Status -->
    <Color x:Key="SuccessBg">#DCF0E6</Color>
    <Color x:Key="SuccessBorder">#2E9E6D</Color>

    <!-- Tekst / obrys -->
    <Color x:Key="TextPrimary">#1B2430</Color>
    <Color x:Key="TextSecondaryOnLight">#727F8C</Color>
    <Color x:Key="TextOnDark">#F3F4EF</Color>
    <Color x:Key="TextOnDarkMuted">#CCF3F4EF</Color>
    <Color x:Key="BorderStrong">#1B2430</Color>
    <Color x:Key="BorderSoft">#C9CDC3</Color>
    <Color x:Key="BorderHairline">#1A1B2430</Color>

</ResourceDictionary>
