<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TabletTracker.Controls"
             x:Class="TabletTracker.Pages.SettingsPage"
             Title="Ustawienia"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid ColumnDefinitions="224,*">

        <controls:SidebarView Grid.Column="0" ActiveRoute="Settings" />

        <Grid Grid.Column="1" RowDefinitions="Auto,*" Padding="34,30,34,20" RowSpacing="16">

            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label Text="Ustawienia" Style="{StaticResource PageTitle}" />
                <Label Text="Konfiguracja aplikacji" Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="12" MaximumWidthRequest="460" HorizontalOptions="Start">

                <Label Text="NAUCZYCIEL" Style="{StaticResource SectionLabel}" />
                <Label Text="Imię i nazwisko nauczyciela będzie dopisywane do każdego skanu."
                       FontSize="13" TextColor="#99727F8C" />
                <Border Style="{StaticResource FieldFrame}">
                    <Entry x:Name="TeacherNameEntry"
                           Placeholder="Np. M. Javappen"
                           Style="{StaticResource FieldEntry}" Margin="17,0" />
                </Border>
                <Label x:Name="SavedHint" Text="Zapisano." FontSize="12.5"
                       TextColor="{StaticResource SuccessBorder}" IsVisible="False" />
                <Button Text="Zapisz"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalOptions="Start"
                        Clicked="OnSaveTeacherClicked" />

            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>